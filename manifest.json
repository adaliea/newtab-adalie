{
  "manifest_version": 3,
  "key": "",
  "name": "Adalie's New Tab",
  "version": "1.0.0",
  "description": "A minimal new tab page with calendar, tasks, weather, GitHub, and Canvas.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "identity",
    "storage",
    "topSites"
  ],
  "host_permissions": [
    "https://api.openweathermap.org/*",
    "https://api.github.com/*",
    "https://www.googleapis.com/*",
    "https://xkcd.com/*",
    "https://ws.audioscrobbler.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "1076513527084-jrhsvfivdm90dth6m1k2i0lj940g6ghn.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/tasks"
    ]
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
